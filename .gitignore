# ---- 编译产物 --------------------------------------------------------------
vst/build/
*.o
*.a
*.dylib
*.so

# ---- 测试临时目录 ----------------------------------------------------------
# pytest 的 basetemp 会留下很大的目录（曾经积到 464MB），一律不进仓库
vst/.pytest_tmp/
.pytest_tmp/
vst/.pytest_cache/
.pytest_cache/
__pycache__/
*.pyc

# ---- 第三方依赖 ------------------------------------------------------------
# JUCE 不提交进仓库（约 100MB），用 vst/setup_juce.sh 按精确版本拉取
vst/external/JUCE/

# ---- 渲染产物 --------------------------------------------------------------
# 试听用的 wav 可以重新生成；打包好的 zip 属于交付物，不属于源码
outputs/*.wav
outputs/*.zip
outputs/*/ 

# ---- macOS -----------------------------------------------------------------
.DS_Store
._*
__MACOSX/
